<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subway Surfers 2D Clone</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #222;
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: white;
            overflow: hidden;
        }

        #game-container {
            position: relative;
            box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.7);
        }

        #score-board {
            position: absolute;
            top: 10px;
            left: 20px;
            font-size: 20px;
            font-weight: bold;
            z-index: 10;
            background: rgba(0,0,0,0.5);
            padding: 5px 10px;
            border-radius: 5px;
        }

        canvas {
            background: linear-gradient(to bottom, #87CEEB, #555); /* Sky to Ground */
            display: block;
            border: 4px solid #fff;
            border-radius: 10px;
        }

        #game-over-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
        }

        #game-over-screen.hidden {
            display: none;
        }

        button {
            padding: 10px 20px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            background-color: #ffcc00;
            border: none;
            border-radius: 5px;
            margin-top: 15px;
        }

        button:hover {
            background-color: #e6b800;
        }
    </style>
</head>
<body>

    <div id="game-container">
        <div id="score-board">Score: <span id="score">0</span> | Coins: <span id="coins">0</span></div>
        <canvas id="gameCanvas" width="800" height="400"></canvas>
        <div id="game-over-screen" class="hidden">
            <h1>Game Over!</h1>
            <p>Press "Space" or Click Restart to Play Again</p>
            <button id="restart-btn">Restart</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");
        const scoreEl = document.getElementById("score");
        const coinsEl = document.getElementById("coins");
        const gameOverScreen = document.getElementById("game-over-screen");
        const restartBtn = document.getElementById("restart-btn");

        // गेम वेरिएबल्स
        let score = 0;
        let coins = 0;
        let gameActive = true;
        let obstacles = [];
        let collectibles = [];
        let gameSpeed = 5;
        let frameCount = 0;

        // प्लेयर ऑब्जेक्ट
        const player = {
            x: 100,
            y: 300,
            width: 40,
            height: 60,
            originalHeight: 60,
            crouchHeight: 30,
            color: "#ff3366",
            jumping: false,
            crouching: false,
            ySpeed: 0,
            gravity: 0.6,
            jumpPower: -12,
            groundY: 300
        };

        // कीबोर्ड कंट्रोल्स
        const keys = {};
        window.addEventListener("keydown", (e) => {
            keys[e.code] = true;
            
            // Jump: Up Arrow या W
            if ((e.code === "ArrowUp" || e.code === "KeyW") && !player.jumping && !player.crouching) {
                player.ySpeed = player.jumpPower;
                player.jumping = true;
            }
            // Crouch: Down Arrow या S
            if (e.code === "ArrowDown" || e.code === "KeyS") {
                player.crouching = true;
                player.height = player.crouchHeight;
                if(!player.jumping) player.y = player.groundY + (player.originalHeight - player.crouchHeight);
            }
            // Restart on Space when Game Over
            if (e.code === "Space" && !gameActive) {
                restartGame();
            }
        });

        window.addEventListener("keyup", (e) => {
            keys[e.code] = false;
            if (e.code === "ArrowDown" || e.code === "KeyS") {
                player.crouching = false;
                player.height = player.originalHeight;
                if(!player.jumping) player.y = player.groundY;
            }
        });

        // रुकावटें (Obstacles) बनाना
        function spawnObstacle() {
            const type = Math.random() > 0.5 ? "tall" : "wide";
            if (type === "tall") {
                obstacles.push({
                    x: canvas.width,
                    y: 320,
                    width: 30,
                    height: 40,
                    color: "#33ccff"
                });
            } else {
                obstacles.push({
                    x: canvas.width,
                    y: 260,
                    width: 40,
                    height: 30,
                    color: "#ffcc00"
                });
            }
        }

        // सिक्के (Coins) स्पॉन करना
        function spawnCoin() {
            collectibles.push({
                x: canvas.width,
                y: Math.random() > 0.5 ? 250 : 310,
                radius: 10,
                color: "#ffd700"
            });
        }

        // कोलिशन डिटेक्शन
        function checkCollision(rect1, rect2) {
            return rect1.x < rect2.x + rect2.width &&
                   rect1.x + rect1.width > rect2.x &&
                   rect1.y < rect2.y + rect2.height &&
                   rect1.y + rect1.height > rect2.y;
        }

        // गेम रीस्टार्ट
        function restartGame() {
            score = 0;
            coins = 0;
            obstacles = [];
            collectibles = [];
            gameSpeed = 5;
            gameActive = true;
            player.y = player.groundY;
            player.ySpeed = 0;
            player.jumping = false;
            gameOverScreen.classList.add("hidden");
            animate();
        }

        restartBtn.addEventListener("click", restartGame);

        // मेन गेम लूप
        function animate() {
            if (!gameActive) return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            frameCount++;

            // ज़मीन बनाना
            ctx.fillStyle = "#444";
            ctx.fillRect(0, 360, canvas.width, 40); 

            // प्लेयर का मूवमेंट और ग्रेविटी
            if (player.jumping) {
                player.ySpeed += player.gravity;
                player.y += player.ySpeed;

                if (player.y >= player.groundY) {
                    player.y = player.groundY;
                    player.jumping = false;
                    player.ySpeed = 0;
                }
            }
            
            // प्लेयर ड्रा करना
            ctx.fillStyle = player.color;
            ctx.fillRect(player.x, player.y, player.width, player.height);

            // बाधाओं को संभालना
            if (frameCount % 120 === 0) spawnObstacle();
            
            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.x -= gameSpeed;
                
                ctx.fillStyle = obs.color;
                ctx.fillRect(obs.x, obs.y, obs.width, obs.height);

                if (checkCollision(player, obs)) {
                    gameActive = false;
                    gameOverScreen.classList.remove("hidden");
                }

                if (obs.x + obs.width < 0) obstacles.splice(i, 1);
            }

            // कॉइन्स को संभालना
            if (frameCount % 80 === 0) spawnCoin();
            
            for (let i = collectibles.length - 1; i >= 0; i--) {
                let coin = collectibles[i];
                coin.x -= gameSpeed;

                ctx.beginPath();
                ctx.arc(coin.x, coin.y, coin.radius, 0, Math.PI * 2);
                ctx.fillStyle = coin.color;
                ctx.fill();
                ctx.closePath();

                let coinRect = { x: coin.x - coin.radius, y: coin.y - coin.radius, width: coin.radius * 2, height: coin.radius * 2 };
                if (checkCollision(player, coinRect)) {
                    coins++;
                    coinsEl.innerText = coins;
                    collectibles.splice(i, 1);
                    continue;
                }

                if (coin.x + coin.radius < 0) collectibles.splice(i, 1);
            }

            // स्कोर और स्पीड बढ़ाना
            score++;
            scoreEl.innerText = score;
            if (score % 500 === 0) gameSpeed += 0.5;

            requestAnimationFrame(animate);
        }

        // गेम शुरू करें
        animate();
    </script>
</body>
</html>
