<script>
"use strict";
const $=id=>document.getElementById(id);let angleMode="DEG",historyItems=[];
try{const s=JSON.parse(localStorage.getItem("ajitCalcHistory")||"[]");if(Array.isArray(s))historyItems=s}catch(e){}
function toast(m){const b=$("toast");b.textContent=m;b.classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>b.classList.remove("show"),2200)}
function saveHistory(expr,result){historyItems.unshift({expr,result,time:new Date().toLocaleString()});historyItems=historyItems.slice(0,100);try{localStorage.setItem("ajitCalcHistory",JSON.stringify(historyItems))}catch(e){}}
document.querySelectorAll(".tab").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===b));document.querySelectorAll(".page").forEach(p=>p.classList.toggle("active",p.id===b.dataset.page));if(b.dataset.page==="history")renderHistory();if(b.dataset.page==="converter")convertUnits();if(b.dataset.page==="programmer")convertProgrammer()}));
function tokenize(expression){const s=expression.replace(/\s+/g,"");const t=[];let i=0;while(i<s.length){const r=s.slice(i),n=r.match(/^(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?/i);if(n){t.push({type:"number",value:Number(n[0])});i+=n[0].length;continue}const name=r.match(/^[a-zA-Z]+/);if(name){t.push({type:"name",value:name[0].toLowerCase()});i+=name[0].length;continue}const c=s[i];if("+-*/%^()".includes(c)){t.push({type:c,value:c});i++;continue}throw Error("गलत चिन्ह: "+c)}return t}
function exactTrig(fn,x){
 if(angleMode!=="DEG")return null;
 const v=((x%360)+360)%360;
 const near=(a,b)=>Math.abs(a-b)<1e-9;
 const vals={
 sin:[[0,"0"],[30,"1/2"],[45,"√2/2"],[60,"√3/2"],[90,"1"],[120,"√3/2"],[135,"√2/2"],[150,"1/2"],[180,"0"],[210,"-1/2"],[225,"-√2/2"],[240,"-√3/2"],[270,"-1"],[300,"-√3/2"],[315,"-√2/2"],[330,"-1/2"]],
 cos:[[0,"1"],[30,"√3/2"],[45,"√2/2"],[60,"1/2"],[90,"0"],[120,"-1/2"],[135,"-√2/2"],[150,"-√3/2"],[180,"-1"],[210,"-√3/2"],[225,"-√2/2"],[240,"-1/2"],[270,"0"],[300,"1/2"],[315,"√2/2"],[330,"√3/2"]],
 tan:[[0,"0"],[30,"√3/3"],[45,"1"],[60,"√3"],[90,"undefined"],[120,"-√3"],[135,"-1"],[150,"-√3/3"],[180,"0"],[210,"√3/3"],[225,"1"],[240,"√3"],[270,"undefined"],[300,"-√3"],[315,"-1"],[330,"-√3/3"]]};
 for(const [a,s] of vals[fn])if(near(v,a)){if(s==="undefined")throw Error("यह मान अपरिभाषित है");return {exact:s,value:fn==="sin"?Math.sin(x*Math.PI/180):fn==="cos"?Math.cos(x*Math.PI/180):Math.tan(x*Math.PI/180)}}
 return null;
}
function fmt(n){if(!Number.isFinite(n))throw Error("उत्तर परिभाषित नहीं है");if(Math.abs(n)<1e-12)n=0;return Number(n.toPrecision(12)).toString()}
function calculate(expression){
 const tokens=tokenize(expression);let pos=0;if(!tokens.length)throw Error("पहले गणना लिखो");
 const peek=()=>tokens[pos];const take=type=>{const t=tokens[pos];if(!t||t.type!==type)throw Error("Expression पूरा नहीं है");pos++;return t};
 function primary(){const t=peek();if(!t)throw Error("Expression पूरा नहीं है");if(t.type==="+"){pos++;return unary()}if(t.type==="-"){pos++;return -unary()}if(t.type==="number"){pos++;return t.value}if(t.type==="("){pos++;const v=add();take(")");return v}if(t.type==="name"){pos++;const n=t.value;if(n==="pi")return Math.PI;if(n==="e")return Math.E;if(!(n in funcs))throw Error("Unknown function: "+n);take("(");const x=add();take(")");const out=funcs[n](x);if(typeof out==="object")return out;return out}throw Error("गलत expression")}
 function unary(){return primary()}
 function power(){let a=primary();if(peek()&&peek().type==="^"){pos++;a=Math.pow(a,power())}return a}
 function mul(){let a=power();while(peek()&&["*","/","%"].includes(peek().type)){const op=peek().type;pos++;const b=power();a=op==="*"?num(a)*num(b):op==="/"?num(a)/num(b):num(a)%num(b)}return a}
 function add(){let a=mul();while(peek()&&["+","-"].includes(peek().type)){const op=peek().type;pos++;const b=mul();a=op==="+"?num(a)+num(b):num(a)-num(b)}return a}
 const num=x=>typeof x==="object"?x.value:x;
 const funcs={
 sin:x=>{const q=exactTrig("sin",num(x));return q||Math.sin(angleMode==="DEG"?num(x)*Math.PI/180:num(x))},
 cos:x=>{const q=exactTrig("cos",num(x));return q||Math.cos(angleMode==="DEG"?num(x)*Math.PI/180:num(x))},
 tan:x=>{const q=exactTrig("tan",num(x));return q||Math.tan(angleMode==="DEG"?num(x)*Math.PI/180:num(x))},
 asin:x=>angleMode==="DEG"?Math.asin(num(x))*180/Math.PI:Math.asin(num(x)),
 acos:x=>angleMode==="DEG"?Math.acos(num(x))*180/Math.PI:Math.acos(num(x)),
 atan:x=>angleMode==="DEG"?Math.atan(num(x))*180/Math.PI:Math.atan(num(x)),sqrt:x=>Math.sqrt(num(x)),log:x=>Math.log10(num(x)),ln:x=>Math.log(num(x)),abs:x=>Math.abs(num(x)),floor:x=>Math.floor(num(x)),ceil:x=>Math.ceil(num(x)),round:x=>Math.round(num(x)),exp:x=>Math.exp(num(x))};
 let value=add();if(pos!==tokens.length)throw Error("अतिरिक्त चिन्ह");if(typeof value==="object")return value;if(!Number.isFinite(value))throw Error("उत्तर परिभाषित नहीं है");return {value,exact:null}
}
function compute(input){let s=input.trim();if(!s)throw Error("पहले गणना लिखो");s=s.replace(/×/g,"*").replace(/÷/g,"/").replace(/π/gi,"pi").replace(/√\(/g,"sqrt(");const r=calculate(s);return r}
function showResult(input,outEl,save=false){try{const r=compute(input);outEl.classList.remove("error");outEl.textContent=r.exact||fmt(r.value);if(save)saveHistory(input,outEl.textContent);return r}catch(e){outEl.classList.add("error");outEl.textContent=e.message||"गलत गणना";return null}}
function wireCalc(inputId,resultId,keysId){const input=$(inputId),result=$(resultId),keys=$(keysId);input.addEventListener("input",()=>{if(input.value.trim())showResult(input.v
