r:white}.primary,.secondary,.danger-btn{padding:12px 14px;border:0;border-radius:11px;font-weight:800}.primary{background:linear-gradient(135deg,#087bff,#00dfff);color:#00101b}.secondary{background:#122239;border:1px solid var(--border);color:var(--cyan)}.danger-btn{background:#301522;border:1px solid #693047;color:#ff9bb4}.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1}.output-box{margin-top:13px;padding:14px;border:1px solid var(--border);border-radius:12px;background:#050d1b;overflow-wrap:anywhere}.output-label{font-size:11px;color:var(--muted);margin-bottom:8px}.output-value{font-size:24px;color:var(--cyan);font-weight:800}.history-list{display:grid;gap:8px}.history-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px;border:1px solid #1b3049;border-radius:11px;background:#081324}.history-expression{font-size:13px;color:#afc2da;overflow-wrap:anywhere}.history-answer{color:var(--cyan);font-weight:800;margin-top:5px;overflow-wrap:anywhere}.history-actions{display:flex;gap:5px;flex-shrink:0}.mini-btn{padding:8px;border:1px solid #26405b;border-radius:8px;background:#102038;color:var(--cyan);font-size:12px}.empty{text-align:center;color:var(--muted);padding:30px 10px;line-height:1.8}.footer{text-align:center;color:#71849d;font-size:11px;padding:22px 0 10px}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,15px);opacity:0;pointer-events:none;z-index:20;background:#10253b;border:1px solid var(--cyan);border-radius:12px;padding:12px 16px;color:white;font-size:13px;max-width:90%;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}.small-note{color:var(--muted);font-size:11px;line-height:1.7;margin-top:11px}.converter-result{display:grid;gap:8px}.converter-result div{padding:11px;border:1px solid #1c334c;border-radius:10px;background:#081323;overflow-wrap:anywhere}.converter-result strong{color:var(--cyan)}.exact-note{padding:10px 12px;border:1px solid #1b4256;border-radius:10px;color:#bdefff;background:#061827;font-size:12px;line-height:1.6;margin-bottom:12px}
