<script>
"use strict";

/* ------------------------------
   AJIT CALCULATOR PRO
------------------------------ */

const $ = id => document.getElementById(id);

let angleMode = "DEG";
let historyItems = [];

try {
  const saved = JSON.parse(localStorage.getItem("ajitCalcHistory") || "[]");
  if (Array.isArray(saved)) historyItems = saved;
} catch (_) {}

function toast(message) {
  const box = $("toast");
  box.textContent = message;
  box.classList.add("show");
  clearTimeout(toast.timer);
  toast.timer = setTimeout(() => box.classList.remove("show"), 2300);
}

/* ---------- NAVIGATION ---------- */

document.querySelectorAll(".tab").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(b => {
      b.classList.toggle("active", b === button);
    });

    document.querySelectorAll(".page").forEach(page => {
      page.classList.toggle("active", page.id === button.dataset.page);
    });

    if (button.dataset.page === "history") renderHistory();
    if (button.dataset.page === "converter") convertUnits();
    if (button.dataset.page === "programmer") convertProgrammer();
  });
});

/* ---------- SAFE MATHEMATICAL PARSER ---------- */

/*
  This parser supports:
  + - * / % ^ parentheses and whitelisted functions.
  It does not evaluate arbitrary JavaScript.
*/

function tokenize(expression) {
  const s = expression.replace(/\s+/g, "");
  const tokens = [];
  let i = 0;

  while (i < s.length) {
    const rest = s.slice(i);
    const number = rest.match(/^(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?/i);

    if (number) {
      tokens.push({type:"number", value:Number(number[0])});
      i += number[0].length;
      continue;
    }

    const name = rest.match(/^[a-zA-Z]+/);
    if (name) {
      tokens.push({type:"name", value:name[0].toLowerCase()});
      i += name[0].length;
      continue;
    }

    const char = s[i];

    if ("+-*/%^()".includes(char)) {
      tokens.push({type:char, value:char});
      i++;
      continue;
    }

    throw new Error("गलत चिन्ह: " + char);
  }

  return tokens;
}

const FUNCTIONS = {
  sin: x => Math.sin(angleMode === "DEG" ? x * Math.PI / 180 : x),
  cos: x => Math.cos(angleMode === "DEG" ? x * Math.PI / 180 : x),
  tan: x => Math.tan(angleMode === "DEG" ? x * Math.PI / 180 : x),
  asin: x => angleMode === "DEG" ? Math.asin(x) * 180 / Math.PI : Math.asin(x),
  acos: x => angleMode === "DEG" ? Math.acos(x) * 180 / Math.PI : Math.acos(x),
  atan: x => angleMode === "DEG" ? Math.atan(x) * 180 / Math.PI : Math.atan(x),
  sqrt: Math.sqrt,
  log: Math.log10,
  ln: Math.log,
  abs: Math.abs,
  floor: Math.floor,
  ceil: Math.ceil,
  round: Math.round,
  exp: Math.exp
};

function calculate(expression) {
  const tokens = tokenize(expression);
  let pos = 0;

  if (!tokens.length) throw new Error("पहले गणना लिखो");

  function peek() {
    return tokens[pos];
  }

  function take(type) {
    const token = tokens[pos];
    if (!token || token.type !== type) {
      throw new Error("Expression पूरा नहीं है");
    }
    pos++;
    return token;
  }

  function parsePrimary() {
    const token = peek();
    if (!token) throw new Error("Expression पूरा नहीं है");

    if (token.type === "+") {
      pos++;
      return parseUnary();
    }

    if (token.type === "-") {
      pos++;
      return -parseUnary();
    }

    if (token.type === "number") {
      pos+
