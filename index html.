
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07111f">
<title>LIVE SCORE | Cricket</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
 background:#07111f;color:#fff;
 font-family:Arial,sans-serif;
 min-height:100vh;
}
header{
 padding:22px 16px;
 background:linear-gradient(135deg,#082d48,#075985);
 border-bottom:1px solid #164e63;
}
.header{
 max-width:900px;margin:auto;
 display:flex;justify-content:space-between;
 align-items:center;gap:10px;
}
.logo{font-size:25px;font-weight:900;letter-spacing:1px}
.logo span{color:#38e8b5}
.tag{font-size:11px;color:#a5f3fc;margin-top:5px}
.live-indicator{
 background:#dc2626;padding:7px 12px;
 border-radius:20px;font-size:12px;font-weight:bold;
}
main{max-width:900px;margin:auto;padding:18px 13px}
.welcome{
 padding:18px;border-radius:16px;
 background:linear-gradient(120deg,#102b44,#102039);
 margin-bottom:20px;
}
.welcome h2{font-size:21px;margin-bottom:7px}
.welcome p{color:#9fb3c8;font-size:13px;line-height:1.5}
.toolbar{
 display:flex;gap:9px;margin-bottom:15px;
}
.search{
 flex:1;min-width:0;padding:13px;
 background:#14263a;border:1px solid #29445e;
 border-radius:10px;color:white;outline:none;
 font-size:14px;
}
button{
 border:0;cursor:pointer;font-weight:bold;
}
.refresh{
 padding:0 15px;border-radius:10px;
 background:#0891b2;color:white;font-size:14px;
}
.filters{
 display:flex;gap:8px;overflow-x:auto;
 padding-bottom:13px;margin-bottom:8px;
}
.filter{
 padding:9px 17px;border-radius:22px;
 background:#172a40;color:#cbd5e1;
 white-space:nowrap;font-size:13px;
}
.filter.active{background:#0891b2;color:white}
.info{
 color:#91a5b9;font-size:12px;
 margin-bottom:15px;
 display:flex;justify-content:space-between;
 gap:8px;flex-wrap:wrap;
}
.match{
 background:linear-gradient(145deg,#132940,#0d1b2d);
 border:1px solid #24445c;
 border-radius:15px;padding:17px;
 margin-bottom:13px;
}
.match-top{
 display:flex;justify-content:space-between;
 gap:10px;align-items:center;margin-bottom:17px;
}
.tournament{font-size:12px;color:#9db3c8}
.status{
 font-size:11px;font-weight:bold;
 color:#cbd5e1;background:#263c51;
 padding:6px 9px;border-radius:15px;
}
.status.live{background:#7f1d1d;color:#fecaca}
.teams{
 display:grid;grid-template-columns:1fr 1fr;
 gap:12px;
}
.team{text-align:center;min-width:0}
.team-name{
 font-size:15px;font-weight:bold;
 overflow-wrap:anywhere;
}
.score{
 font-size:25px;font-weight:900;
 color:#fff;margin-top:10px;
}
.score small{font-size:12px;color:#9fb3c8}
.vs{
 text-align:center;color:#64748b;
 font-size:12px;margin:12px 0;
}
.match-status{
 border-top:1px solid #294158;
 margin-top:17px;padding-top:12px;
 color:#9fb3c8;font-size:12px;
 text-align:center;line-height:1.5;
}
.empty{
 text-align:center;padding:45px 15px;
 background:#12243a;border-radius:15px;
 color:#9fb3c8;line-height:1.8;
}
.loading{text-align:center;padding:35px;color:#67e8f9}
footer{
 text-align:center;padding:25px 12px;
 color:#8498ad;font-size:12px;line-height:2;
}
footer a{color:#38bdf8}
@media(max-width:420px){
 .logo{font-size:21px}
 .score{font-size:21px}
 .team-name{font-size:13px}
}
</style>
</head>

<body>

<header>
 <div class="header">
  <div>
   <div class="logo">🏏 LIVE <span>SCORE</span></div>
   <div class="tag">YOUR CRICKET SCORE CENTER</div>
  </div>
  <div class="live-indicator">● LIVE</div>
 </div>
</header>

<main>

 <section class="welcome">
  <h2>Cricket Live Scores 🏏</h2>
  <p>दुनिया भर के क्रिकेट मैचों के स्कोर और मैच की स्थिति यहां देखें।</p>
 </section>

 <div class="toolbar">
  <input id="search" class="search"
   type="search" placeholder="टीम या मैच खोजें...">
  <button class="refresh" id="refresh">↻ Refresh</button>
 </div>

 <div class="filters">
  <button class="filter active" data-filter="all">सभी मैच</button>
  <button class="filter" data-filter="live">🔴 LIVE</button>
  <button class="filter" data-filter="upcoming">आने वाले</button>
  <button class="filter" data-filter="finished">समाप्त</button>
 </div>

 <div class="info">
  <span id="matchCount">मैच लोड हो रहे हैं...</span>
  <span id="lastUpdate">अपडेट का इंतजार...</span>
 </div>

 <div id="matches">
  <div class="loading">🏏 मैच लोड हो रहे हैं...</div>
 </div>

</main>

<footer>
 <div>Made with ❤️ | LIVE SCORE</div>
 <div>Cricket data provided by
 <a href="https://sportscore.com/" target="_blank" rel="noopener">
 SportScore
 </a>
 </div>
 <div>Automatic update every 60 seconds</div>
</footer>

<script>
const API =
 "https://sportscore.com/api/widget/matches/?sport=cricket&limit=50";

const container = document.getElementById("matches");
const search = document.getElementById("search");
const count = document.getElementById("matchCount");
const lastUpdate = document.getElementById("lastUpdate");
const refreshBtn = document.getElementById("refresh");

let allMatches = [];
let currentFilter = "all";
let loading = false;

function safe(value){
 return String(value ?? "").replace(/[&<>"']/g, c => ({
  "&":"&amp;","<":"&lt;",">":"&gt;",
  '"':"&quot;","'":"&#39;"
 }[c]));
}

function getText(value){
 if(value === null || value === undefined) return "";
 if(typeof value === "object"){
  if(Array.isArray(value)){
   return value.map(getText).filter(Boolean).join(" | ");
  }
  return [
   value.runs !== undefined ? value.runs : "",
   value.wickets !== undefined ? "/"+value.wickets : "",
   value.overs !== undefined ? " ("+value.overs+" ov)" : ""
  ].join("") || "";
 }
 return String(value);
}

function getStatus(match){
 return (
  String(match.status || "") + " " +
  String(match.status_text || "")
 ).toLowerCase();
}

function category(match){
 const s = getStatus(match);

 if(/live|in.play|in_progress|innings|stumps/.test(s))
  return "live";

 if(/finish|complete|result|abandon|cancel/.test(s))
  return "finished";

 if(/upcoming|scheduled|not.started|preview/.test(s))
  return "upcoming";

 return "other";
}

function makeScore(match, side){
 const score = match[side+"_score"];
 if(score !== undefined && score !== null && score !== "")
  return getText(score);

 const innings = match.innings;
 if(Array.isArray(innings)){
  const team = match[side];
  const found = innings.filter(i =>
   String(i.team || i.team_name || "").toLowerCase() ===
   String(team || "").toLowerCase()
  );
  if(found.length){
   return found.map(i => getText(i.score || i)).join(" | ");
  }
 }
 return "—";
}

function render(){
 const query = search.value.toLowerCase().trim();

 const filtered = allMatches.filter(m => {
  const name = (
   String(m.home || "") + " " +
   String(m.away || "") + " " +
   String(m.status_text || "")
  ).toLowerCase();

  const matchFilter =
   currentFilter === "all" ||
   category(m) === currentFilter;

  return matchFilter && name.includes(query);
 });

 count.textContent = filtered.length + " मैच";

 if(!filtered.length){
  container.innerHTML = `
   <div class="empty">
    <div style="font-size:35px">🏏</div>
    <h3>कोई मैच नहीं मिला</h3>
    <p>अभी इस कैटेगरी में मैच उपलब्ध नहीं है।</p>
   </div>`;
  return;
 }

 container.innerHTML = filtered.map(m => {
  const status = category(m);
  const label = status === "live" ? "● LIVE" :
   status === "finished" ? "FINISHED" :
   status === "upcoming" ? "UPCOMING" :
   safe(m.status_text || m.status || "MATCH");

  return `
   <article class="match">
    <div class="match-top">
     <div class="tournament">
      🏆 ${safe(m.competition || "Cricket Match")}
     </div>
     <span class="status ${status === "live" ? "live" : ""}">
      ${label}
     </span>
    </div>

    <div class="teams">
     <div class="team">
      <div class="team-name">${safe(m.home || "Team 1")}</div>
      <div class="score">
       ${safe(makeScore(m,"home"))}
      </div>
     </div>

     <div class="team">
      <div class="team-name">${safe(m.away || "Team 2")}</div>
      <div class="score">
       ${safe(makeScore(m,"away"))}
      </div>
     </div>
    </div>

    <div class="vs">VS</div>

    <div class="match-status">
     ${safe(m.status_text || m.status || "Match details")}
    </div>
   </article>
  `;
 }).join("");
}

async function loadMatches(){
 if(loading) return;
 loading = true;

 refreshBtn.textContent = "Loading...";

 if(!allMatches.length){
  container.innerHTML =
   '<div class="loading">🏏 लाइव स्कोर लोड हो रहा है...</div>';
 }

 try{
  const response = await fetch(API,{
   method:"GET",
   cache:"no-store"
  });

  if(!response.ok){
   throw new Error("API error: "+response.status);
  }

  const data = await response.json();

  if(!Array.isArray(data.matches)){
   throw new Error("Invalid API response");
  }

  allMatches = data.matches;

  render();

  lastUpdate.textContent =
   "Updated: " + new Date().toLocaleTimeString("en-IN");

 }catch(error){
  console.error(error);

  if(!allMatches.length){
   container.innerHTML = `
    <div class="empty">
     <div style="font-size:35px">⚠️</div>
     <h3>स्कोर लोड नहीं हो पाया</h3>
     <p>इंटरनेट या API में समस्या हो सकती है।</p>
     <p>कृपया Refresh दबाएं।</p>
    </div>`;
  }else{
   lastUpdate.textContent = "अपडेट असफल, पुराना डेटा दिखाया जा रहा है";
  }

 }finally{
  loading = false;
  refreshBtn.textContent = "↻ Refresh";
 }
}

document.querySelectorAll(".filter").forEach(btn => {
 btn.addEventListener("click",()=>{
  document.querySelectorAll(".filter").forEach(b=>
   b.classList.remove("active")
  );
  btn.classList.add("active");
  currentFilter = btn.dataset.filter;
  render();
 });
});

search.addEventListener("input",render);
refreshBtn.addEventListener("click",loadMatches);

loadMatches();
setInterval(loadMatches,60000);
</script>

</body>
</html>
