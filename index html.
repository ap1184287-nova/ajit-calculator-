<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#030712">
<meta name="description" content="AJIT CALCULATOR PRO - Free Basic, Scientific, Unit Converter and Programmer Calculator">
<title>AJIT CALCULATOR PRO</title>

<style>
:root{
  --bg:#030712;
  --panel:#0a1222;
  --panel2:#101c30;
  --blue:#078bff;
  --cyan:#00eaff;
  --text:#eff8ff;
  --muted:#91a6c1;
  --border:rgba(0,234,255,.17);
  --green:#54ffbb;
  --red:#ff668a;
}
*{box-sizing:border-box}
body{
  margin:0;
  min-height:100vh;
  background:
    radial-gradient(ellipse at 10% 0%,rgba(0,113,255,.15),transparent 35%),
    radial-gradient(ellipse at 100% 20%,rgba(0,234,255,.08),transparent 35%),
    var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
}
button,input,select{font:inherit}
button{cursor:pointer;touch-action:manipulation}
button:focus-visible,input:focus-visible,select:focus-visible{
  outline:2px solid var(--cyan);
  outline-offset:2px;
}
.app{max-width:1100px;margin:auto;padding:18px}
.header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin:8px 0 24px;
}
.brand{display:flex;align-items:center;gap:12px}
.logo{
  width:49px;height:49px;border-radius:15px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,var(--blue),var(--cyan));
  color:#00111d;font-size:20px;font-weight:1000;
  box-shadow:0 0 25px rgba(0,234,255,.22);
}
.brand h1{font-size:19px;margin:0;letter-spacing:.8px}
.brand h1 span{color:var(--cyan)}
.brand p{margin:5px 0 0;color:var(--muted);font-size:10px;letter-spacing:1.6px}
.badge{
  border:1px solid var(--border);border-radius:30px;
  padding:9px 12px;color:var(--cyan);font-size:11px;font-weight:bold;
}
.tabs{
  display:grid;grid-template-columns:repeat(5,minmax(0,1fr));
  gap:8px;margin-bottom:18px;
}
.tab{
  padding:13px 6px;border:1px solid #1b3049;border-radius:13px;
  background:var(--panel);color:#bfd1e6;font-size:12px;font-weight:800;
}
.tab.active{
  background:linear-gradient(135deg,#087bff,#00cfff);
  color:#00101b;border-color:transparent;
  box-shadow:0 0 20px rgba(0,234,255,.13);
}
.panel{
  background:linear-gradient(145deg,rgba(13,25,44,.97),rgba(5,12,25,.98));
  border:1px solid var(--border);border-radius:22px;
  padding:18px;box-shadow:0 18px 50px rgba(0,0,0,.22);
}
.page{display:none}
.page.active{display:block}
.display{
  border:1px solid #1d3854;border-radius:17px;
  padding:18px 16px;background:#030916;margin-bottom:14px;
  overflow:hidden;
}
.display-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.display-label{font-size:10px;color:var(--muted);letter-spacing:1.5px}
.mode-btn{
  border:1px solid var(--border);border-radius:9px;
  background:#0d2034;color:var(--cyan);padding:7px 10px;
  font-size:11px;font-weight:bold;
}
.expression{
  width:100%;border:0;outline:none;background:transparent;
  color:#a9c5e3;text-align:right;font-size:18px;
  margin-top:22px;min-height:28px;
}
.result{
  width:100%;overflow-wrap:anywhere;text-align:right;
  color:var(--cyan);font-size:clamp(30px,7vw,47px);
  font-weight:800;min-height:55px;margin-top:7px;
  text-shadow:0 0 20px rgba(0,234,255,.15);
}
.result.error{color:var(--red);font-size:22px}
.keypad{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;
}
.key{
  min-height:57px;border:1px solid #1b3049;border-radius:14px;
  background:linear-gradient(145deg,#122039,#0b1424);
  color:#f0f7ff;font-size:19px;font-weight:700;
  box-shadow:0 3px 0 #040914;transition:transform .1s,border-color .15s;
}
.key:active{transform:scale(.96)}
.key.func{color:var(--cyan);background:#0b2031}
.key.op{color:#7cbaff;background:#0d1c30}
.key.danger{color:#ff8ca6;background:#291421}
.key.equal{
  color:#00111b;background:linear-gradient(135deg,#078bff,#00eaff);
  border:0;font-size:24px;
}
.key.wide{grid-column:span 2}
.section-title{font-size:20px;margin:0 0 7px}
.section-desc{color:var(--muted);font-size:12px;line-height:1.6;margin:0 0 18px}
.scientific-grid{
  display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;
  margin-bottom:10px;
}
.scikey{
  min-height:47px;border-radius:11px;border:1px solid #1b3b55;
  background:#0b2032;color:var(--cyan);font-size:13px;font-weight:800;
}
.scikey:active{background:#123754}
.scientific-grid .key{min-height:48px;font-size:15px}
.field{
  display:flex;flex-direction:column;gap:7px;margin-bottom:14px;
}
.field label{font-size:12px;color:#b5c8df}
.field input,.field select,.convert-input{
  width:100%;min-width:0;padding:13px;
  border:1px solid #29415b;border-radius:12px;
  background:#050d1b;color:white;outline:none;
}
.field select option{background:#081426;color:white}
.primary,.secondary,.danger-btn{
  padding:12px 15px;border:0;border-radius:12px;
  font-weight:800;
}
.primary{background:linear-gradient(135deg,#087bff,#00dfff);color:#00101b}
.secondary{background:#122239;border:1px solid var(--border);color:var(--cyan)}
.danger-btn{background:#301522;border:1px solid #693047;color:#ff9bb4}
.row{display:flex;gap:9px;flex-wrap:wrap}
.row>*{flex:1}
.output-box{
  margin-top:14px;padding:15px;border:1px solid var(--border);
  border-radius:13px;background:#050d1b;overflow-wrap:anywhere;
}
.output-label{font-size:11px;color:var(--muted);margin-bottom:8px}
.output-value{font-size:24px;color:var(--cyan);font-weight:800}
.history-list{display:grid;gap:9px}
.history-item{
  display:flex;justify-content:space-between;align-items:center;gap:12px;
  padding:13px;border:1px solid #1b3049;border-radius:12px;
  background:#081324;
}
.history-expression{font-size:13px;color:#afc2da;overflow-wrap:anywhere}
.history-answer{color:var(--cyan);font-weight:800;margin-top:5px;overflow-wrap:anywhere}
.history-actions{display:flex;gap:5px;flex-shrink:0}
.mini-btn{
  padding:8px;border:1px solid #26405b;border-radius:8px;
  background:#102038;color:var(--cyan);font-size:12px;
}
.empty{text-align:center;color:var(--muted);padding:35px 10px;line-height:1.8}
.footer{text-align:center;color:#71849d;font-size:11px;padding:23px 0 10px}
.toast{
  position:fixed;bottom:20px;left:50%;transform:translate(-50%,15px);
  opacity:0;pointer-events:none;z-index:20;
  background:#10253b;border:1px solid var(--cyan);
  border-radius:12px;padding:12px 16px;color:white;
  font-size:13px;max-width:90%;transition:.2s;
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.small-note{color:var(--muted);font-size:11px;line-height:1.7;margin-top:12px}
.converter-result{display:grid;gap:9px}
.converter-result div{
  padding:12px;border:1px solid #1c334c;border-radius:10px;
  background:#081323;overflow-wrap:anywhere;
}
.converter-result strong{color:var(--cyan)}
@media(max-width:600px){
  .app{padding:12px}
  .header{margin:5px 0 18px}
  .brand h1{font-size:15px}
  .brand p{font-size:8px;letter-spacing:1px}
  .logo{width:42px;height:42px}
  .badge{font-size:9px;padding:8px}
  .tabs{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
  .tab{padding:12px 4px;font-size:11px}
  .panel{padding:12px;border-radius:17px}
  .keypad{gap:7px}
  .key{min-height:53px;border-radius:12px;font-size:18px}
  .scientific-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
  .scientific-grid .key,.scikey{min-height:44px;font-size:12px}
  .display{padding:15px 12px}
  .expression{font-size:16px}
  .result{font-size:35px}
}
</style>
</head>

